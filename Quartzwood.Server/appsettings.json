{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Scryfall": {
    "RefreshDays": 1,
    "ImageCachePath": "image-cache"
  },
  "Backups": {
    "Enabled": true,
    "Folder": "Backups",
    "IntervalHours": 24,
    "KeepDaily": 7,
    "KeepWeekly": 4,
    "KeepMonthly": 12
  }
}
